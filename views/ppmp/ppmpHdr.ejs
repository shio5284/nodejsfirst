<%- include('../_partial/_header.ejs') %>



 


                                                                                                                                                     
  <div class="row">
    <div class="col-md-6">
      <h5>Project Porcurement MAnagement Plan</h5>
    </div>
  </div>
  

    <form action="/ppmp/saveppmpHdr" method="post" >
      <div class="row" style="text-align: center;">
        <div class="form-group col-md-12">
          <label name="lblDepartment" class="sr-only mt-md-12"
            style="font-size: xx-large; padding: 0px 45px 30px 0px;" > <%=departmentdesc %></label>
        </div>
        <div class="row">
          <div class="form-group col-md-6">
          </div>
          <div class="form-group col-md-4">
            <label class="sr-only mt-md-2" style="font-size: larger; font-weight: 500; text-align: left;">PPMP type
            </label>
          </div>
        </div>
        <div class="row">
          <div class="form-group col-md-2">
            <label class="sr-only mt-md-2" style="font-size: larger; font-weight: 500; text-align: left;">Fiscal Year</label>
          </div>
          <div class="form-group col-md-2">
            <select class="form-control" name="fiscalYear">
              <option value=0>-select Fiscal Year-</option>
              <option value="2025">2025</option>
              <option value="2026">2026</option>
               <option value="2027">2027</option>
            </select>
          </div>
          <div class="form-group col-md-2">
          </div>
          <div class="form-group col-md-2">
            <input type="radio" id="html" name="ppmptype" value="Indicative">
            <label for="html">Indicative</label><br>

          </div>

          <div class="form-group col-md-2">

            <input type="radio" id="css" name="ppmptype" value="Final">
            <label for="css">Final</label><br>
          </div>
        </div>
      </div>


    <div class="row">

<div class="form-group col sr-only mt-md-12" style="text-align: center; padding-top: 20px;">
       
      <button type="submit" class="btn btn-primary">Save PPMP Header</button>

        <input type="hidden" id="departmentId" name="hiddepartmentId" value = "<%= departmentId %>">
  <input type="hidden" id="personId" name="hidpersonId" value = "<%= personId %>">
    </div>
</div>



    </form>

  </div>