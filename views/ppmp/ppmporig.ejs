      <h4>Project Porcurement Management Plan</h4>
    </div>
  </div>


  <div style="background-color:aliceblue; padding: 15px 20px 10px 20px; ">
    <form action="/ppmp" method="POST" >
      <div class="row" style="text-align: center;">
            
       </div>

 <div class="row"> 
      <div class="form-group col-md-5">
        <label for="ppmpselect" class="sr-only mt-md-12"  style="font-size: larger; font-weight: 500; text-align: left;"> PPMP for <%=departmentdesc %>   </label>
        <select class="form-control" name="designation"  onchange="this.form.submit()"> 
            
                   <option value =null >select pppmp </option>
