<%- include('../_partial/_header.ejs') %>


    <div class="row" style="padding-top: 10px">
        <div class="col-md-12" style="text-align: center;">
            <h2>
                <%=departmentdesc %> Department
            </h2>
        </div>
    </div>
    <div class="row">
        <div class="col-md-5">
            <div class="row" style="padding-top: 10px">
                <div class="col-md-6">
                    <h5>Search </h5>
                </div>
            </div>


            <input type="text" id="searchBox" placeholder="Search item..." <%=isAlreadySubmitted!=null? "disabled" : ""
                %> />

            <table class="table table-bordered">
                <thead>
                    <tr>
                        <!-- <th>Item Code</th> -->
                        <th style="background-color: aqua;">Description</th>
                        <th style="background-color: aqua;"> Price</th>
                        <th style="background-color: aqua;">Unit </th>
                        <th style="background-color: aqua;">Action</th>
                    </tr>
                </thead>
                <tbody id="results"></tbody>
            </table>
       

  <% if (status!=null){ %>
        <div style="padding-top: 10px;">
            status
          
                <Table style="width:auto; background-color: aliceblue;">

                    <th style="background-color: beige;">

                    <td style="background-color: beige; text-align: center;">
                        <label style="font-weight:600; ;">Assigned </label>
                    </td>
                    <td style="background-color: beige; text-align: center;">
                        <label style="font-weight:600;">Date</label>
                    </td>


                    </th>

                    <tr>
                        <td style="background-color: beige;">
                            <input type="checkbox" onclick="return false;" class="colored-checkbox"
                                <%=status.submittedPR==true? "checked" : "" %>>
                            <label for="vehicle1">Submitted</label>
                        </td style="background-color: beige;">
                        <td style="background-color: beige;">
                            <label for="vehicle1">
                                <%= status.submittedPrBy %>
                            </label>
                        </td>
                        <td style="background-color: beige;">
                            <label for="vehicle1">
                                <%= (status.submittedPrDate) %>
                            </label>
                        </td>


                    </tr>


                    <tr>
                        <td style="background-color: beige;">
                            <input type="checkbox" onclick="return false;" class="colored-checkbox"
                                <%=status.bidding==true? "checked" : "" %>>
                            <label for="vehicle1">Bidding</label>
                        </td>
                        <td style="background-color: beige;">
                            <label for="vehicle1">
                                <%= status.biddingBy %>
                            </label>
                        </td>
                        <td style="background-color: beige;">
                            <label for="vehicle1">
                                <%= (status.biddingDate) %>
                            </label>
                        </td>


                    </tr>

                    <tr>
                        <td style="background-color: beige;">
                            <input type="checkbox" onclick="return false;" class="colored-checkbox"
                                <%=status.purchased==true? "checked" : "" %>>
                            <label for="vehicle1">Purchased</label>
                        </td>
                        <td style="background-color: beige;">
                            <label for="vehicle1">
                                <%= status.purchasedBy %>
                            </label>
                        </td>
                        <td style="background-color: beige;">
                            <label for="vehicle1">
                                <%= (status.purhasedDate) %>
                            </label>
                        </td>


                    </tr>
                    <tr>
                        <td style="background-color: beige;">
                            <input type="checkbox" onclick="return false;" class="colored-checkbox"
                                <%=status.accepted==true? "checked" : "" %>>
                            <label for="vehicle1">Accepted</label>
                        </td>
                        <td style="background-color: beige;">
                            <label for="vehicle1">
                                <%= status.acceptedBy %>
                            </label>
                        </td>
                        <td style="background-color: beige;">
                            <label for="vehicle1">
                                <%= (status.acceptedDate) %>
                            </label>
                        </td>


                    </tr>

                </Table>

              

        </div>
          <% }%>
 </div>






        <div class="col-md-7">


            <div class="row" style="padding-top: 10px">
                <div class="col-md-8">
                    <h4>Purchase Request </h4>
                </div>
                <div class="col-md-2">
                    Fiscal Year
                </div>

                <div class="form-group col-md-2">

                    <select class="form-control" name="defaultFiscalYear">
                        <option>2026 </option>
                        <option selected>2027 </option>
                        <option>2028 </option>
                    </select>
                </div>
            </div>


            <table class="table table-bordered">
                <thead>
                    <tr>

                        <th>General Description</th>
                        <th>Quantity</th>
                        <th>Est. Bubget</th>
                        <th>Status</th>

                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% ppmpPurchaseRequests.forEach(ppmpPurchaseRequest=> { %>
                        <tr>


                            <td>
                                <%= ppmpPurchaseRequest.generalDescName %>
                            </td>
                            <td>
                                <%= ppmpPurchaseRequest.quantity %>
                            </td>
                            <td>
                                <%= (Number(ppmpPurchaseRequest.quantity) *
                                    Number(ppmpPurchaseRequest.price)).toFixed(2) %>
                            </td>

                            <td>
                                <%= ppmpPurchaseRequest.status %>

                            </td>

                            <td>
                                <button class="btn btn-warning btn-sm editBtnPR"
                                    data-id="<%= ppmpPurchaseRequest._id %>"
                                    data-generaldescription="<%= ppmpPurchaseRequest.generalDescName %>"
                                    data-quantity="<%= ppmpPurchaseRequest.quantity %>" remarks data-bs-toggle="modal"
                                    data-bs-target="#editModal">
                                    edit
                                </button>





                                <button class="btn btn-danger btn-sm deleteBtnPR"
                                    data-id="<%= ppmpPurchaseRequest._id  %>"
                                    data-name="<%= ppmpPurchaseRequest.generalDescName %>" data-bs-toggle="modal"
                                    data-bs-target="#deleteModalPR">
                                    Remove
                                </button>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
            <div style="text-align: center;">
                <% if (currentPage> 1) { %>
                    <a href="/ppmpPR/?search=<%= search %>&page=<%= currentPage - 1 %>">⬅
                        Prev</a>
                    <% } %>

                        Page <%= currentPage %> of <%= totalPages %>

                                <% if (currentPage < totalPages) { %>
                                    <a href="/ppmpPR/?search=<%= search %>&page=<%= currentPage + 1 %>">Next
                                        ➡</a>
                                    <% } %>
            </div>
            <div class="row" style="text-align:center; padding-top: 30px;">
                <div class="col-md-6">
                    <form method="POST" action="/ppmpPR/submitPR">
                        <button class="btn btn-primary" <%=isAlreadySubmitted!=null? "disabled" : "" %> >Submit Purchase
                            Request</button>
                        <input type="hidden" id="departmentId" name="hiddepartmentId" value="<%= departmentId %>">
                        <input type="hidden" id="personId" name="hidpersonId" value="<%= personId %>">
                        <input type="hidden" id="itemCode" name="itemCode">
                    </form>
                </div>
                <div class="col-md-6">
                    <form method="POST" action="/ppmpPR/acceptItem">
                        <button class="btn btn-primary" <%=isAlreadyAccepted!=null? "disabled" : "" %> >Accept
                            Item</button>
                        <input type="hidden" id="departmentId" name="hiddepartmentIdAcceptItem"
                            value="<%= departmentId %>">
                        <input type="hidden" id="personId" name="hidpersonIdAcceptItem" value="<%= personId %>">

                    </form>
                </div>
            </div>
        </div>


    </div>
    <!-- modal for adding pr  -->

    <div class="modal fade" id="addPrModal">
        <div class="modal-dialog">
            <form method="POST" action="/ppmpPR/createPR" class="modal-content">
                <div class="modal-header" style="background-color:aquamarine">
                    <h5>Add Item to Purchase Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="form-group col-md-5">
                            <label for="lastname" class="sr-only mt-md-3">General Description</label>
                            <input type="text" class="form-control" name="generalDescName" id="generalDescName"
                                readonly="readonly">
                        </div>
                        <div class="form-group col-md-2">
                            <label for="bday" class="sr-only mt-md-3">Price per Unit </label>
                            <input type="text" class="form-control" name="pricePerUnit" id="PricePerUnit"
                                readonly="readonly">
                        </div>
                        <div class="form-group col-md-2">
                            <label for="bday" class="sr-only mt-md-3">Quantity </label>
                            <input type="number" class="form-control" name="quantity" id="quantity" required>
                        </div>
                        <div class="form-group col-md-2">
                            <label for="bday" class="sr-only mt-md-3">Unit </label>
                            <input type="text" class="form-control" name="unitofMeasurement" id="UnitofMeasurement"
                                readonly="readonly">
                        </div>

                    </div>


                    <div class="modal-footer">
                        <input type="hidden" id="departmentId" name="hiddepartmentId" value="<%= departmentId %>">
                        <input type="hidden" id="personId" name="hidpersonId" value="<%= personId %>">
                        <input type="hidden" id="itemCodePR" name="itemCodePR">
                        <button class="btn btn-primary">Add PR</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div style="text-align: right">

    </div>





    <!-- modal for Edit PR -->
    <div class="modal fade" id="editModal" tabindex="-1">
        <div class="modal-dialog">
            <form id="editForm" method="POST" class="modal-content" style="background-color: aquamarine;">

                <div class="modal-header">
                    <h5 class="modal-title">Edit PPMP Purchase Request Item</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div class="row">
                        <div class="form-group col-md-8">
                            <label for="lastname" class="sr-only mt-md-3">General Description</label>
                            <input type="text" class="form-control" name="generalDescName" id="editgeneralDescName"
                                readonly>
                        </div>
                        <div class="form-group col-md-4">
                            <label for="Price" class="sr-only mt-md-3">data-quantity</label>
                            <input type="number" class="form-control" name="quantity" id="editQuantity" required>
                        </div>

                    </div>


                    <div class="modal-footer">
                        <button class="btn btn-primary">Update</button>
                    </div>
                </div>

            </form>
        </div>
    </div>


    <!-- modal for delete PR -->
    <div class="modal fade" id="deleteModalPR" tabindex="-1">
        <div class="modal-dialog">
            <form id="deleteFormPR" method="POST" class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Confirm Remove </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    Are you sure you want to remove <strong id="deleteNamePR"> purchase request </strong>?
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-danger">Delete</button>
                </div>

            </form>
        </div>
    </div>

    <div class="modal fade" id="createModal">
        <div class="modal-dialog">
            <form method="POST" action="/ppmpItem/createPpmpItem" class="modal-content">
                <div class="modal-header" style="background-color:blue">
                    <h5>Add PPMP Item</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="form-group col-md-8">
                            <label for="lastname" class="sr-only mt-md-3">General Description</label>
                            <input type="text" class="form-control" name="generalDescName"
                                placeholder="General Description of PPMP" required>
                        </div>
                        <div class="form-group col-md-3">
                            <label for="bday" class="sr-only mt-md-3">Procurement Mode</label>
                            <select class="form-control" name="procMode" id="editprocurementMode" required>
                                <option value=""> </option>
                                <% procModes.forEach(function(procMode){ %>
                                    <option value="<%=procMode.procModeDesc %>">

                                        <%=procMode.procModeDesc %>

                                    </option>


                                    <% })%>
                            </select>
                        </div>

                    </div>

                    <div class="row">

                        <div class="form-group col-md-4">
                            <label for="Price" class="sr-only mt-md-4">Price(estimate)</label>
                            <input type="number" class="form-control" name="price" required>
                        </div>
                        <div class="form-group col-md-4">
                            <label for="bday" class="sr-only mt-md-4">Unit Of Measurement</label>
                            <select class="form-control" name="unitOfMeasurement" id="unitOfMeasurement">
                                <option value=""> </option>
                                <% unitOfMeasurements.forEach(function(unitOfMeasurement){ %>
                                    <option value="<%=unitOfMeasurement.unitOfMeasurementDesc %>"
                                        <%="seletedDepartmentDecs"===unitOfMeasurement.unitOfMeasurementDesc? "selected"
                                        : "" %>>

                                        <%= unitOfMeasurement.unitOfMeasurementDesc %>

                                    </option>


                                    <% })%>
                            </select>
                        </div>
                        <div class="form-group col-md-4">

                            <label for="Bday" class="sr-only mt-md-4">Remarks </label>
                            <input type="input" class="form-control" name="remarks" value="">



                        </div>





                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-primary">Save</button>
                    </div>
                </div>
            </form>
        </div>
    </div>